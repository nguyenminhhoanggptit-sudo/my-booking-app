# Sao chép file này thành ".env" (cùng thư mục với server.js). KHÔNG commit file .env lên Git.
PORT=5000
# MongoDB cài trên máy. Nếu dùng MongoDB Atlas thì dán chuỗi kết nối của Atlas vào đây.
MONGO_URI=mongodb://127.0.0.1:27017/booking_app
# Chuỗi bí mật dùng để ký JWT: dài, ngẫu nhiên, không chia sẻ. BẮT BUỘC phải có.
JWT_SECRET=doi-thanh-chuoi-bi-mat-that-dai-va-ngau-nhien